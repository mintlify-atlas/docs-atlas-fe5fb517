  "keyFeatures": [
    "Real-time state synchronization with delta-compressed, binary-encoded patches",
    "Built-in matchmaking with room-based architecture, filtering, and queuing",
    "Authoritative server model for cheat-proof game logic",
    "Horizontal scaling via Redis presence and drivers",
    "Multiple transport options: WebSockets (ws, uWebSockets, Bun)",
    "Authentication module with JWT, OAuth, email/password support",
    "Built-in rooms: LobbyRoom, RelayRoom, QueueRoom",
    "TypeScript-first API with full type inference",
    "Client SDKs for TypeScript, Unity, Godot, GameMaker, Defold, Construct3, Haxe, and more",
    "Dev mode with hot-reload and room state restoration"
  ],
  "publicApiSurface": [
    "Server (defineServer, defineRoom)",
    "Room (onCreate, onJoin, onLeave, onDispose, onAuth, onDrop, onReconnect, onBeforePatch)",
    "Room.broadcast(type, message, options)",
    "Room.onMessage(type, callback)",
    "Room.allowReconnection(client, seconds)",
    "Room.disconnect(closeCode)",
    "Room.setMatchmaking(updates)",
    "Room.lock() / Room.unlock()",
    "Client (client.send, client.leave, client.error, client.auth)",
    "matchMaker.joinOrCreate / matchMaker.create / matchMaker.join / matchMaker.joinById",
    "matchMaker.query / matchMaker.findOneRoomAvailable",
    "LocalPresence / RedisPresence",
    "LocalDriver / RedisDriver / MongooseDriver / DrizzleDriver",
    "LobbyRoom / RelayRoom / QueueRoom",
    "auth (JWT, OAuth, Hash)",
    "createEndpoint / createRouter / createMiddleware",
    "@colyseus/schema (Schema, MapSchema, ArraySchema, SetSchema)",
    "@colyseus/testing (ColyseusTestServer)",
    "@colyseus/monitor (monitoring dashboard)",
    "@colyseus/tools (colyseus.config.ts scaffolding)"
  ]
}
